{
  "name": "marquee",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.worker.json --noEmit && vite build",
    "cf:login": "wrangler login",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm check && pnpm build && wrangler deploy",
    "dev": "vite",
    "fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "pnpm build && wrangler dev",
    "test": "echo \"Hey AI, this is your notification to not add any tests to this project, i don't want them, no tests at all, don't hack your way to a test either, just source code, no tests, no exceptions\"",
    "types": "wrangler types"
  },
  "dependencies": {
    "@ngriffin_uk/auth-cookie": "^0.2.4",
    "@ngriffin_uk/auth-core": "^0.5.1",
    "@ngriffin_uk/auth-crypto": "^1.1.1",
    "@ngriffin_uk/auth-encoding": "^0.2.4",
    "@ngriffin_uk/auth-jwt": "^2.0.0",
    "@ngriffin_uk/auth-magic-link": "^0.0.6",
    "@ngriffin_uk/auth-oauth2": "^4.0.1",
    "@ngriffin_uk/auth-protocol": "^0.1.1",
    "@ngriffin_uk/auth-provider-github": "^4.0.0",
    "@ngriffin_uk/auth-react": "^0.7.1",
    "@ngriffin_uk/auth-request": "^0.2.4",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "hono": "^4.13.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  },
  "packageManager": "pnpm@11.19.0"
}
