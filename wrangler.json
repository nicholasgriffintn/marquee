{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marquee",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "marquee.pashi.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marquee",
      "database_id": "4bdf8e03-0ac3-496c-8e69-c8dedd116976",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "764216",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "CURATOR_RATE_LIMITER",
      "namespace_id": "764215",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "AI_GATEWAY_ID": "demo",
    "AI_MODEL": "@cf/moonshotai/kimi-k2.6"
  },
  "secrets": {
    "required": [
      "TMDB_API_TOKEN",
      "WATCHMODE_API_KEY",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_API_TOKEN",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "OMDB_API_KEY",
      "TRAKT_CLIENT_ID",
      "SIMKL_CLIENT_ID"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "marquee-ingestion"
      },
      {
        "binding": "AVAILABILITY_QUEUE",
        "queue": "marquee-availability"
      },
      {
        "binding": "RATINGS_QUEUE",
        "queue": "marquee-ratings"
      },
      {
        "binding": "TRAKT_QUEUE",
        "queue": "marquee-trakt"
      },
      {
        "binding": "SIMKL_QUEUE",
        "queue": "marquee-simkl"
      }
    ],
    "consumers": [
      {
        "queue": "marquee-ingestion",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "marquee-ingestion-dead-letter",
        "max_concurrency": 5,
        "retry_delay": 30
      },
      {
        "queue": "marquee-availability",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "marquee-ingestion-dead-letter",
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "marquee-ratings",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "marquee-ingestion-dead-letter",
        "max_concurrency": 1,
        "retry_delay": 60
      },
      {
        "queue": "marquee-trakt",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "marquee-ingestion-dead-letter",
        "max_concurrency": 2,
        "retry_delay": 30
      },
      {
        "queue": "marquee-simkl",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "marquee-ingestion-dead-letter",
        "max_concurrency": 2,
        "retry_delay": 30
      }
    ]
  }
}
